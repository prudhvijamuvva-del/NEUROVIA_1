# BrandShield AI - Backend Environment Variables
DJANGO_SECRET_KEY=change-this-in-production-secure-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL in production; defaults to SQLite for local development)
DB_ENGINE=sqlite
DB_NAME=brandshield_db
DB_USER=postgres
DB_PASSWORD=postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# OTP Verification Configuration
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
IS_DEMO_OTP_ENABLED=True

# Optional Email SMTP Provider (Leave empty to use dev console delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional SMS Twilio Provider (Leave empty to use dev console delivery)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional AI LLM Explanation Provider (template fallback operates automatically when unset)
LLM_PROVIDER=template
LLM_API_KEY=

# Optional Social API Credentials
META_APP_ID=
META_APP_SECRET=
TWITTER_BEARER_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
